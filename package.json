{
  "name": "amd-agent",
  "version": "0.4.2",
  "description": "AMD Agent - a transparent multi-model agent desktop app",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --outDir dist",
    "predev": "npm run doctor:electron",
    "build": "electron-vite build --outDir dist && npm run build:cli",
    "preview": "electron-vite preview",
    "start": "electron .",
    "prestart": "npm run doctor:electron",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "pack": "npm run prepare:package && electron-builder",
    "pack:mac:x64": "npm run prepare:package && electron-builder --mac --x64",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "postinstall": "node scripts/ensure-electron-binary.mjs",
    "doctor:electron": "node scripts/ensure-electron-binary.mjs",
    "prepare:package": "npm run doctor:electron && npm run build && node scripts/release-check.mjs",
    "pack:dir": "npm run prepare:package && electron-builder --dir",
    "release:check": "npm run build && node scripts/release-check.mjs",
    "smoke:renderer": "node scripts/smoke-renderer.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "cli": "npm run build:cli --silent && node dist/cli/newai.mjs",
    "eval": "npm run build:cli --silent && node dist/cli/newai.mjs eval",
    "check:dependencies": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.68.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@google/generative-ai": "0.24.1",
    "@vscode/ripgrep": "1.18.0",
    "antd": "6.7.0",
    "better-sqlite3": "13.0.3",
    "ignore": "7.0.14",
    "lucide-react": "1.66.0",
    "openai": "6.49.0",
    "picomatch": "4.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "refractor": "5.0.0",
    "shell-quote": "1.12.0",
    "tree-sitter-wasms": "0.1.13",
    "typebox": "1.3.27",
    "uuid": "13.0.2",
    "web-tree-sitter": "0.20.8"
  },
  "devDependencies": {
    "@electron/get": "2.0.3",
    "@electron/rebuild": "3.7.2",
    "@tailwindcss/vite": "4.3.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "esbuild": "0.25.12"
  },
  "build": {
    "appId": "com.newai.agent",
    "productName": "NewAi",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "public/**/*",
      "!node_modules/tree-sitter-wasms/out/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@vscode",
        "to": "ripgrep",
        "filter": [
          "ripgrep-*/bin/rg",
          "ripgrep-*/bin/rg.exe"
        ]
      },
      {
        "from": "node_modules/tree-sitter-wasms/out",
        "to": "codebase-grammars",
        "filter": [
          "tree-sitter-typescript.wasm",
          "tree-sitter-tsx.wasm",
          "tree-sitter-javascript.wasm",
          "tree-sitter-python.wasm",
          "tree-sitter-go.wasm",
          "tree-sitter-rust.wasm",
          "tree-sitter-java.wasm"
        ]
      }
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "npmRebuild": false
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "author": "AMD Agent Contributors",
  "bin": {
    "newai": "dist/cli/newai.mjs"
  }
}
